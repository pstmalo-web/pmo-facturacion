# Copiar a .env.local. Los valores de Supabase los imprime `npx supabase start`
# (API URL y publishable/anon key del stack LOCAL). Nunca pongas aquí las
# claves del Supabase de producción del PMO.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Factory HKA — SOLO el ambiente demo. Sin estas variables la app funciona
# igual, pero Emitir queda deshabilitado (/api/hka/folios responde
# configurado:false, que es un estado normal).
HKA_AMBIENTE=demo
HKA_USUARIO=
HKA_CLAVE=
HKA_SUCURSAL=0000
HKA_PUNTO=002
